{
  "schemaVersion": 1,
  "id": "mezz_config_gui_test_fabric_defaults",
  "version": "${version}",

  "name": "MezzConfig GUI Fabric Defaults Test",
  "description": "Default MezzConfig-backed config screen test for MezzConfig GUI on Fabric.",
  "authors": [
    "${modAuthor}"
  ],

  "license": "The MIT License (MIT)",

  "environment": "client",
  "entrypoints": {
    "mezz_config_client_plugin": [
      "net.mezzdev.config.gui.test.fabric.defaults.FabricMezzConfigDefaultsTestPlugin"
    ],
    "mezz_config_gui_plugin": [
      "net.mezzdev.config.gui.test.fabric.defaults.FabricMezzConfigDefaultsTestPlugin"
    ]
  },

  "depends": {
    "fabricloader": "${fabricLoaderVersionRange}",
    "minecraft": "${minecraftVersion}",
    "${configModId}": "${mezzConfigFabricVersionRange}",
    "${configGuiModId}": "*",
    "java": ">=${modJavaVersion}"
  }
}
