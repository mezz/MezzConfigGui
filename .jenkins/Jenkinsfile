library(
    identifier: 'jenkins-release-notifier@v0.2.0',
    retriever: modernSCM([
        $class: 'GitSCMSource',
        remote: 'https://github.com/mezz/jenkins-release-notifier.git'
    ])
)

def getMavenDeployDir() {
    if (env.MAVEN_DEPLOY_DIR?.trim()) {
        return env.MAVEN_DEPLOY_DIR.trim()
    }
    if (env.local_maven_url?.trim()) {
        return env.local_maven_url.trim()
    }
    if (env.local_maven?.trim()) {
        return env.local_maven.trim()
    }
    return ''
}

def getReleaseVersion() {
    if (!env.RELEASE_TAG?.trim()) {
        error 'No release tag was found on HEAD; refusing to publish without a tag version.'
    }
    def tagName = env.RELEASE_TAG.trim()
    if (tagName.startsWith('refs/tags/')) {
        tagName = tagName.substring('refs/tags/'.length())
    }
    if (!(tagName ==~ /mc26\.1\.2-[0-9]+\.[0-9]+\.[0-9]+/)) {
        error "Could not determine release version from RELEASE_TAG='${env.RELEASE_TAG}'."
    }
    return tagName
}

def shellQuote(String value) {
    return "'" + value.replace("'", "'\"'\"'") + "'"
}

def getReleaseGradleArgs() {
    if (env.RELEASE_TAG?.trim()) {
        return "-PRELEASE_VERSION=${shellQuote(getReleaseVersion())}"
    }
    return ''
}

String releaseMarker(String tagName) {
    return "mezzconfiggui-release:v1:${tagName}"
}

String notifierSourceMarker(String commit) {
    return "jenkins-release-notifier-source:v1:${commit}"
}

def buildDescriptionMarkers(String description) {
    return description?.readLines()?.collect { it.trim() }?.findAll { it } ?: []
}

String completedReleaseDescription(String tagName, String commit) {
    return [releaseMarker(tagName), notifierSourceMarker(commit)].join('\n')
}

def wasReleasePublished(String tagName) {
    def marker = releaseMarker(tagName)
    def previousBuild = currentBuild.previousBuild
    while (previousBuild != null) {
        if (previousBuild.result == 'SUCCESS' && buildDescriptionMarkers(previousBuild.description).contains(marker)) {
            return true
        }
        previousBuild = previousBuild.previousBuild
    }
    return false
}

def findPreviousReleaseCommit() {
    def descriptionPrefix = 'jenkins-release-notifier-source:v1:'
    def previousBuild = currentBuild.previousBuild
    while (previousBuild != null) {
        for (def marker in buildDescriptionMarkers(previousBuild.description)) {
            if (marker.startsWith(descriptionPrefix)) {
                return marker.substring(descriptionPrefix.length())
            }
        }
        previousBuild = previousBuild.previousBuild
    }
    return env.GIT_PREVIOUS_SUCCESSFUL_COMMIT ?: env.GIT_COMMIT
}

def shouldPublishRelease() {
    return env.BRANCH_NAME == '26.1.2' && !env.CHANGE_ID && (env.RELEASE_TAG?.trim()?.replaceFirst('^refs/tags/', '') ==~ /mc26\.1\.2-[0-9]+\.[0-9]+\.[0-9]+/) &&
        !wasReleasePublished(env.RELEASE_TAG)
}

pipeline {
    agent any
    options {
        disableConcurrentBuilds()
    }
    tools {
        jdk "jdk-25"
    }

    environment {
        ORG_GRADLE_PROJECT_BUILD_NUMBER = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh "chmod +x gradlew"
            }
        }

        stage('Resolve Release Tag') {
            when {
                branch '26.1.2'
            }
            steps {
                script {
                    sh 'git fetch --tags'
                    env.RELEASE_TAG = sh(
                        script: '''
                            head_commit="$(git rev-parse HEAD)"
                            git for-each-ref --sort=-v:refname --format='%(refname:short)' 'refs/tags/mc26.1.2-[0-9]*.[0-9]*.[0-9]*' |
                                while IFS= read -r tag; do
                                    tag_commit="$(git rev-list -n 1 "$tag")"
                                    if [ "$tag_commit" = "$head_commit" ]; then
                                        echo "$tag"
                                        break
                                    fi
                                done
                        ''',
                        returnStdout: true
                    ).trim()
                    if (env.RELEASE_TAG) {
                        if (wasReleasePublished(env.RELEASE_TAG)) {
                            echo "Release tag ${env.RELEASE_TAG} was already published successfully; publishing will be skipped."
                        } else {
                            echo "New release tag found on HEAD: ${env.RELEASE_TAG}"
                        }
                    } else {
                        echo 'No release tag found on HEAD; publishing will be skipped.'
                    }
                }
            }
        }

        stage('Validate Release Version') {
            when {
                expression { env.RELEASE_TAG?.trim() }
            }
            steps {
                script {
                    sh "./gradlew validateReleaseVersion ${getReleaseGradleArgs()} --no-daemon"
                }
            }
        }

        stage('Build and Check') {
            steps {
                script {
                    sh './gradlew clean --no-daemon'
                    sh "./gradlew spotlessCheck build :Common:apiJavadoc :Common:checkJarCompatibility ${getReleaseGradleArgs()} --no-daemon"
                }
            }
        }

        stage('Check Release Metadata') {
            steps {
                script {
                    sh "./gradlew publishMods -PpublishDryRun=true ${getReleaseGradleArgs()} --no-daemon"
                }
            }
        }

        stage('Archive') {
            steps {
                junit allowEmptyResults: true, testResults: '*/build/test-results/**/*.xml'
                archiveArtifacts allowEmptyArchive: true, artifacts: '*/build/libs/*.jar'
                archiveArtifacts artifacts: 'Changelog/build/changelog.*'
            }
        }

        stage('Publish Maven') {
            when {
                expression { shouldPublishRelease() }
            }
            steps {
                script {
                    def releaseVersion = getReleaseVersion()
                    def deployDir = getMavenDeployDir()
                    if (!deployDir) {
                        error 'Jared Maven environment is not set; expected MAVEN_DEPLOY_DIR, local_maven_url, or local_maven.'
                    }
                    sh "./gradlew publishMavenRelease -PDEPLOY_DIR=${shellQuote(deployDir)} -PRELEASE_VERSION=${shellQuote(releaseVersion)} --no-daemon"
                }
            }
        }

        stage('Publish CurseForge') {
            when {
                expression { shouldPublishRelease() }
            }
            environment {
                ORG_GRADLE_PROJECT_curseforgeApikey = credentials('jei-curseforge-key')
            }
            steps {
                script {
                    sh "./gradlew --no-configuration-cache :Fabric:publishCurseforge :NeoForge:publishCurseforge -PpublishDryRun=false ${getReleaseGradleArgs()} --no-daemon"
                }
            }
        }

        stage('Publish Modrinth') {
            when {
                expression { shouldPublishRelease() }
            }
            environment {
                ORG_GRADLE_PROJECT_modrinthToken = credentials('modrinth-auth-token')
            }
            steps {
                script {
                    sh "./gradlew --no-configuration-cache :Fabric:publishModrinth :NeoForge:publishModrinth -PpublishDryRun=false ${getReleaseGradleArgs()} --no-daemon"
                }
            }
        }

        stage('Notify Released Issues') {
            when {
                expression { shouldPublishRelease() && currentBuild.currentResult == 'SUCCESS' }
            }
            steps {
                script {
                    def releaseMetadata = discordNotifier.getGradleReleaseMetadata(version: getReleaseVersion())
                    releaseNotifier(
                        workerJob: '/mezz/release-notifier-worker',
                        repository: 'mezz/MezzConfigGui',
                        channel: releaseMetadata.minecraftVersion,
                        projectName: releaseMetadata.projectName,
                        version: releaseMetadata.version,
                        baseCommit: findPreviousReleaseCommit(),
                        headCommit: env.GIT_COMMIT,
                        releaseLinks: releaseMetadata.releaseLinks,
                        minecraftVersions: [releaseMetadata.minecraftVersion],
                        modLoaders: releaseMetadata.modLoaders
                    )
                }
            }
        }
    }
    post {
        always {
            script {
                def notification = [
                    workerJob: '/mezz/release-notifier-worker',
                    publishSkipped: !shouldPublishRelease()
                ]
                if (env.RELEASE_TAG?.trim()) {
                    notification.version = getReleaseVersion()
                }
                discordNotifier(notification)
            }
        }
        success {
            script {
                if (shouldPublishRelease()) {
                    currentBuild.description = completedReleaseDescription(env.RELEASE_TAG, env.GIT_COMMIT)
                }
            }
        }
    }
}
