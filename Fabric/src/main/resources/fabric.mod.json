{
  "schemaVersion": 1,
  "id": "${configGuiModId}",
  "version": "${version}",

  "name": "MezzConfig GUI",
  "description": "Shared config GUI support for Minecraft mods.",
  "authors": [
    "${modAuthor}"
  ],
  "contact": {
    "sources": "${githubUrl}"
  },

  "license": "The MIT License (MIT)",
  "icon": "mezz_config_gui-icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "net.mezzdev.config.gui.fabric.ConfigGuiFabric"
    ],
    "client": [
      "net.mezzdev.config.gui.fabric.ConfigGuiFabricClient"
    ],
    "mezz_config_gui_plugin": [
      "net.mezzdev.config.gui.config.ConfigGuiOptionsPlugin"
    ],
    "modmenu": [
      "net.mezzdev.config.gui.fabric.ConfigGuiModMenuPlugin"
    ],
    "jei_mod_plugin": [
      "net.mezzdev.config.gui.jei.ConfigGuiPlugin"
    ]
  },
  "accessWidener" : "mezz_config.accesswidener",

  "depends": {
    "fabricloader": "${fabricLoaderVersionRange}",
    "fabric-api": "${fabricApiVersionRange}",
    "minecraft": "${minecraftVersion}",
    "${configModId}": "${mezzConfigFabricVersionRange}",
    "java": ">=${modJavaVersion}"
  },
  "suggests": {
    "amecsapi": "*",
    "modmenu": "*",
    "jei": "*"
  }
}
